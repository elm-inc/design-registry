    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "theme-dense",
      "type": "registry:theme",
      "title": "elm dense (突き合わせて使う管理画面向け)",
      "description": "base の尺度を管理画面向けに詰めた preset。眺めるのではなく突き合わせて使う画面(一覧・ダッシュボード・照合) では、1 画面に入る行数がそのまま使い勝手になる。本文 13px 起点・比 1.2 で type scale を縮め、余白を絞り、content 幅の上限を外す。色・書体・sidebar 寸法は base のまま。base の後に add して重ねる。",
      "cssVars": {
        "theme": {
          "text-display": "1.75rem",
          "text-h1": "1.375rem",
          "text-h2": "1.1875rem",
          "text-h3": "1.0625rem",
          "text-h4": "0.9375rem",
          "text-body": "0.8125rem",
          "text-small": "0.75rem",
          "gutter": "1rem",
          "section-gap": "1rem",
          "page-max": "none"
        }
      },
      "css": {
        "@layer base": {
          "body": {
            "font-size": "var(--text-body)"
          }
        }
      }
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "app-shell",
      "type": "registry:component",
      "title": "elm app-shell",
      "description": "house 標準レイアウト骨格 (sidebar + header + content)。Next.js App Router 想定。@elm/base のトークン (--app-sidebar-width / --page-max / --gutter / --section-gap) を使用。案件は AppSidebar のナビ項目と header 内容だけ差し替える。",
      "registryDependencies": [
        "sidebar",
        "separator",
        "@elm/base"
      ],
      "files": [
        {
          "path": "components/app-shell.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/app-sidebar.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "shell",
      "type": "registry:component",
      "title": "elm shell (画面の共通部品)",
      "description": "shadcn primitives の上に house の組み合わせ方を薄く重ねた共通部品。Panel (見出し付きブロック) / Stat (指標) / Bar (量の横バー) / Empty (値が無いことを空欄にしない) / Dl (ラベルと値の対) / PageHeader (eyebrow・見出し・説明・操作)。案件をまたいで同じ読み方になるよう、組み合わせ方だけを共有し、ドメインの語彙は案件側のコンポーネントで包む。@elm/base のトークンを使用し、量の可視化は chart トークンから着色する。",
      "registryDependencies": [
        "card",
        "tooltip",
        "@elm/base"
      ],
      "files": [
        {
          "path": "components/shell.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/page-header.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "theme-example",
      "type": "registry:theme",
      "title": "theme preset の例 (案件差分)",
      "description": "base の上に案件のブランド差分 (accent 色等) だけを重ねる preset の雛形。base を取り込んだ後に add する。値は例 (base の indigo primary を warm accent に上書き)。",
      "cssVars": {
        "light": {
          "primary": "oklch(0.62 0.19 45)",
          "primary-foreground": "oklch(0.985 0 0)"
        },
        "dark": {
          "primary": "oklch(0.70 0.17 45)",
          "primary-foreground": "oklch(0.205 0 0)"
        }
