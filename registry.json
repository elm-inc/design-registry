{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "elm-design-registry",
  "homepage": "https://elm-inc.github.io/design-registry",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "base",
      "type": "registry:theme",
      "extends": "none",
      "title": "elm base",
      "description": "elm の定常デザインレギュレーション。色トークン (OKLCH light/dark) + type scale (見出し/本文) + spacing/layout トークン + sidebar 寸法 + @layer base の要素既定スタイルを単一ソースで配布。案件は add @elm/base で型/余白/見出しが揃い、差分だけを preset で重ねる。色由来: shadcn/create preset b1ZOy0qg4 (indigo/zinc)。characterful な性格は design-voice 層で足す。",
      "cssVars": {
        "theme": {
          "font-sans": "Inter, ui-sans-serif, system-ui, sans-serif",
          "text-display": "3rem",
          "text-h1": "2.25rem",
          "text-h2": "1.875rem",
          "text-h3": "1.5rem",
          "text-h4": "1.25rem",
          "text-body": "1rem",
          "text-small": "0.875rem",
          "leading-tight": "1.15",
          "leading-snug": "1.3",
          "leading-normal": "1.6",
          "tracking-tight": "-0.02em",
          "tracking-snug": "-0.01em",
          "tracking-normal": "0em",
          "gutter": "1.5rem",
          "section-gap": "4rem",
          "page-max": "80rem",
          "sidebar-width": "16rem",
          "sidebar-width-icon": "3rem",
          "sidebar-width-mobile": "18rem"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.141 0.005 285.823)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.141 0.005 285.823)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.141 0.005 285.823)",
          "primary": "oklch(0.457 0.24 277.023)",
          "primary-foreground": "oklch(0.962 0.018 272.314)",
          "secondary": "oklch(0.967 0.001 286.375)",
          "secondary-foreground": "oklch(0.21 0.006 285.885)",
          "muted": "oklch(0.967 0.001 286.375)",
          "muted-foreground": "oklch(0.552 0.016 285.938)",
          "accent": "oklch(0.967 0.001 286.375)",
          "accent-foreground": "oklch(0.21 0.006 285.885)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.92 0.004 286.32)",
          "input": "oklch(0.92 0.004 286.32)",
          "ring": "oklch(0.705 0.015 286.067)",
          "chart-1": "oklch(0.809 0.105 251.813)",
          "chart-2": "oklch(0.623 0.214 259.815)",
          "chart-3": "oklch(0.546 0.245 262.881)",
          "chart-4": "oklch(0.488 0.243 264.376)",
          "chart-5": "oklch(0.424 0.199 265.638)",
          "radius": "0.625rem",
          "sidebar": "oklch(0.985 0 0)",
          "sidebar-foreground": "oklch(0.141 0.005 285.823)",
          "sidebar-primary": "oklch(0.511 0.262 276.966)",
          "sidebar-primary-foreground": "oklch(0.962 0.018 272.314)",
          "sidebar-accent": "oklch(0.967 0.001 286.375)",
          "sidebar-accent-foreground": "oklch(0.21 0.006 285.885)",
          "sidebar-border": "oklch(0.92 0.004 286.32)",
          "sidebar-ring": "oklch(0.705 0.015 286.067)"
        },
        "dark": {
          "background": "oklch(0.141 0.005 285.823)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.21 0.006 285.885)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.21 0.006 285.885)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.398 0.195 277.366)",
          "primary-foreground": "oklch(0.962 0.018 272.314)",
          "secondary": "oklch(0.274 0.006 286.033)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.274 0.006 286.033)",
          "muted-foreground": "oklch(0.705 0.015 286.067)",
          "accent": "oklch(0.274 0.006 286.033)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.552 0.016 285.938)",
          "chart-1": "oklch(0.809 0.105 251.813)",
          "chart-2": "oklch(0.623 0.214 259.815)",
          "chart-3": "oklch(0.546 0.245 262.881)",
          "chart-4": "oklch(0.488 0.243 264.376)",
          "chart-5": "oklch(0.424 0.199 265.638)",
          "radius": "0.625rem",
          "sidebar": "oklch(0.21 0.006 285.885)",
          "sidebar-foreground": "oklch(0.985 0 0)",
          "sidebar-primary": "oklch(0.585 0.233 277.117)",
          "sidebar-primary-foreground": "oklch(0.962 0.018 272.314)",
          "sidebar-accent": "oklch(0.274 0.006 286.033)",
          "sidebar-accent-foreground": "oklch(0.985 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.552 0.016 285.938)"
        }
      },
      "css": {
        "@layer base": {
          "h1": {
            "font-size": "var(--text-h1)",
            "line-height": "var(--leading-tight)",
            "letter-spacing": "var(--tracking-tight)",
            "font-weight": "700"
          },
          "h2": {
            "font-size": "var(--text-h2)",
            "line-height": "var(--leading-tight)",
            "letter-spacing": "var(--tracking-snug)",
            "font-weight": "700"
          },
          "h3": {
            "font-size": "var(--text-h3)",
            "line-height": "var(--leading-snug)",
            "letter-spacing": "var(--tracking-snug)",
            "font-weight": "600"
          },
          "h4": {
            "font-size": "var(--text-h4)",
            "line-height": "var(--leading-snug)",
            "font-weight": "600"
          },
          "p": {
            "font-size": "var(--text-body)",
            "line-height": "var(--leading-normal)"
          },
          "small": {
            "font-size": "var(--text-small)",
            "line-height": "var(--leading-snug)"
          }
        }
      }
    },
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "theme-example",
      "type": "registry:theme",
      "title": "theme preset の例 (案件差分)",
      "description": "base の上に案件のブランド差分 (accent 色等) だけを重ねる preset の雛形。base を取り込んだ後に add する。値は例 (base の indigo primary を warm accent に上書き)。",
      "cssVars": {
        "light": {
          "primary": "oklch(0.62 0.19 45)",
          "primary-foreground": "oklch(0.985 0 0)"
        },
        "dark": {
          "primary": "oklch(0.70 0.17 45)",
          "primary-foreground": "oklch(0.205 0 0)"
        }
      }
    }
  ]
