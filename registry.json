          "gutter": "1.5rem",
          "section-gap": "4rem",
          "page-max": "80rem",
          "app-sidebar-width": "16rem",
          "app-sidebar-width-icon": "3rem",
          "app-sidebar-width-mobile": "18rem"
        },
        "light": {
